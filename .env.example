# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...

# Only needed if agent/config.yaml funding.provider is "openrouter".
# Management key from openrouter.ai/settings/keys — used read-only to poll
# the credit balance. The agent never sees it.
OPENROUTER_MANAGEMENT_KEY=

# Only needed if agent/config.yaml provider is "openai_compat" — the key for
# whichever endpoint you point at (the variable name must match api_key_env
# in config): Moonshot/Kimi (MOONSHOT_API_KEY), DeepSeek (DEEPSEEK_API_KEY),
# OpenAI (OPENAI_API_KEY), OpenRouter (OPENROUTER_API_KEY)...
MOONSHOT_API_KEY=
